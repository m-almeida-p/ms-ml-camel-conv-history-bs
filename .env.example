# Copy to .env (git-ignored) and fill in the token:  cp .env.example .env
KARAVAN_PORT=9998
KARAVAN_REGISTRY_PORT=5555
KARAVAN_GIT_REPOSITORY=https://github.com/m-almeida-p/ms-ml-camel-conv-history-bs.git
KARAVAN_GIT_USERNAME=m-almeida-p
KARAVAN_GIT_BRANCH=main

# Local only: karavan-db is not published on the host.
KARAVAN_DATASOURCE_USERNAME=karavan
KARAVAN_DATASOURCE_PASSWORD=karavan

# Fine-grained PAT of m-almeida-p, limited to this repo (Contents: read and
# write). Set it in .env, never here.
GITHUB_MALMEIDAP_PAT=

# Microsoft Foundry project endpoint (not a secret): https://<resource>.services.ai.azure.com/api/projects/<project>
# Authentication is Microsoft Entra ID: sign in with `az login`; no key or token is stored here.
FOUNDRY_PROJECT_ENDPOINT=

# Service principal the token broker uses to get Microsoft Entra ID tokens for Foundry (local PoC).
# Role: Foundry User, on the Foundry project only. Create it with the command in docs; the secret lives only in .env.
FOUNDRY_TENANT_ID=
FOUNDRY_CLIENT_ID=
FOUNDRY_CLIENT_SECRET=
